<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms" 
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Inwentaryzacja.RaportPage">
  <ContentPage.Content>
        <StackLayout BackgroundColor="#8EE3BA" xmlns:android="clr-namespace:Xamarin.Forms.PlatformConfiguration.AndroidSpecific;assembly=Xamarin.Forms.Core">
            <Label Text="Sala XX" TextColor="Black" HorizontalOptions="Center" FontSize="50" TextDecorations="Underline" FontAttributes="Bold"/>
            <ListView  Margin="15" RowHeight="120" SeparatorVisibility="None" x:Name="ListaPrzedmiotów">
                <ListView.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>1</x:String>
                        <x:String>2</x:String>
                        <x:String>3</x:String>
                        <x:String>4</x:String>
                        <x:String>5</x:String>
                    </x:Array>
                </ListView.ItemsSource>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <ViewCell>
                            <Frame CornerRadius="10" Margin="10" >
                                <StackLayout BackgroundColor="White" >
                                    <Grid Margin="0" Padding="0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Label Text="Item(id.....)"  FontSize="15" Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2" Grid.RowSpan="2" TextColor="Black" FontAttributes="Bold"/>
                                        <Label Text="Należy do sali .." FontSize="10" Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="2"  TextColor="Gray"/>
                                        <Image Source="ptak.png" Grid.Column="1" Grid.Row="2"/>
                                        <Button Text="Przenieś tutaj" Grid.Column="2" Grid.Row="0" Grid.RowSpan="3"  BackgroundColor="WhiteSmoke" BorderColor="Black" CornerRadius="10" BorderWidth="2" android:Button.UseDefaultShadow="true" />
                                        <Button Text="Nic nie zmieniaj" Grid.Column="3" Grid.Row="0" Grid.RowSpan="3"  BackgroundColor="WhiteSmoke" BorderColor="Black" CornerRadius="10" BorderWidth="2" android:Button.UseDefaultShadow="true"/>
                                    </Grid>
                                </StackLayout>
                            </Frame>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="50"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Text="Przenieś wszystkie tutaj" BackgroundColor="White"  Grid.Column="1" Grid.ColumnSpan="6" Grid.Row="0" Margin="10,0,0,0" CornerRadius="10" FontSize="13" FontAttributes="Italic" android:Button.UseDefaultShadow="true"/>
                <Button Text="Usuń raport" BackgroundColor="White" Grid.Column="0" Grid.ColumnSpan="4" Grid.Row="1" CornerRadius="10" Margin="15,5" FontSize="13" FontAttributes="Italic" android:Button.UseDefaultShadow="true"/>
                <Button Text="Zatwierdź"  BackgroundColor="White" Grid.Column="4" Grid.ColumnSpan="4" Grid.Row="1" CornerRadius="10" Margin="15,5" FontSize="13" FontAttributes="Italic" android:Button.UseDefaultShadow="true"/>
            </Grid>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>